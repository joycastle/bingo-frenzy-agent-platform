# Copy to ~/.local/share/bingo-frenzy-agent-platform/.env on the deployment host.
# This trusted file is sourced by Bash. Use NAME='value'; quote JSON and $ literally.
# Shared by all server-side bots. Keep mode 0600. Restart after changes.
# Keep deployment paths, ports, HOME, PATH and model CLI settings in their existing configuration.

# agent-github uses GH_TOKEN when nonempty, otherwise GIT_TOKEN.
GH_TOKEN=''

# code-worktree registry: {"alias":{"url":"https://github.com/org/repo.git","branch":"master"}}
GIT_REPOSITORIES_JSON=''
GIT_USERNAME='x-access-token'
GIT_TOKEN=''
# SSH fields are reserved; this deployment uses HTTPS through GitHub CLI.
GIT_SSH_KEY_FILE=''
GIT_KNOWN_HOSTS_FILE=''

# 飞书项目官方 MCP：从 https://project.feishu.cn/b/mcp 的 Stdio 配置复制。
# 在飞书页面只开启“允许查看数据信息”；启动器映射为官方 MCP_USER_TOKEN。
FEISHU_PROJECT_MCP_USER_TOKEN=''
