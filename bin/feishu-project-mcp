#!/bin/bash
. "$(dirname "$0")/common.sh"
if [[ ! -f "$STATE_DIR/.env" ]]; then
  echo '缺少 Agent 环境文件。' >&2
  exit 1
fi
set -a
. "$STATE_DIR/.env"
set +a
if [[ -z "${FEISHU_PROJECT_MCP_USER_TOKEN:-}" ]]; then
  echo '请配置 FEISHU_PROJECT_MCP_USER_TOKEN。' >&2
  exit 1
fi
export MCP_USER_TOKEN="$FEISHU_PROJECT_MCP_USER_TOKEN"
exec npx -y "@lark-project/mcp@$FEISHU_PROJECT_MCP_VERSION" --domain https://project.feishu.cn
